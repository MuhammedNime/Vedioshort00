{
  "name": "shorts-quiz-studio",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "start": "node server.ts",
    "build": "vite build",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "android:init": "npx cap add android",
    "cap:sync": "npm run build && npx cap sync android",
    "cap:open": "npx cap open android",
    "cap:apk": "npm run cap:sync && cd android && ./gradlew assembleDebug"
  },
  "dependencies": {
    "@capacitor/android": "^8.6.2",
    "@capacitor/cli": "^8.6.2",
    "@capacitor/core": "^8.6.2",
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.1",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "firebase": "^13.4.0",
    "lucide-react": "^0.546.0",
    "mammoth": "^1.13.0",
    "mathlive": "^0.111.4",
    "motion": "^12.23.24",
    "mp4-muxer": "^5.2.2",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "read-excel-file": "^9.3.20",
    "vite": "^8.3.0",
    "vite-plugin-pwa": "^2.0.0",
    "webm-muxer": "^5.1.4"
  },
  "devDependencies": {
    "@firebase/eslint-plugin-security-rules": "^0.0.2",
