# GEMINI_API_KEY: Primary Gemini API key (or multiple comma/newline-separated keys).
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# GEMINI_API_KEYS: Extra Gemini API keys (comma or newline separated) for automatic quota rotation.
GEMINI_API_KEYS=""

# Optional numbered Gemini keys (for separate GitHub Repository Secrets):
# GEMINI_API_KEY_1=""
# GEMINI_API_KEY_2=""
# GEMINI_API_KEY_3=""
# GEMINI_API_KEY_4=""
# GEMINI_API_KEY_5=""

# Optional Free & External Text AI Fallback Providers (used automatically for quiz & YouTube kit generation):
# Groq (Free tier, ultra-fast Llama 3.3):
# GROQ_API_KEY=""
# GROQ_API_KEYS=""
#
# OpenRouter (supports free :free models like meta-llama/llama-3.3-70b-instruct:free):
# OPENROUTER_API_KEY=""
# OPENROUTER_API_KEYS=""
#
# OpenAI / ChatGPT (also supports CHATGPT_API_KEY):
# OPENAI_API_KEY=""
# OPENAI_API_KEYS=""
#
# Anthropic / Claude (also supports CLAUDE_API_KEY):
# ANTHROPIC_API_KEY=""
# ANTHROPIC_API_KEYS=""
#
# Optional custom fallback order (defaults to free-first order: gemini,groq,openrouter,openai,anthropic):
# AI_PROVIDER_ORDER="gemini,groq,openrouter,openai,anthropic"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# VITE_BASE_PATH: Subpath for GitHub Pages (e.g. "/Shortvedio2/"). Leave "/" for root deployments / APK.
VITE_BASE_PATH="/"

# VITE_API_BASE_URL: Optional deployed backend URL when routing AI requests through a backend server.
# Leave empty to use built-in same-origin /api/* or GitHub Secrets client rotation.
VITE_API_BASE_URL=""

# Optional Google OAuth credentials for direct YouTube upload integration
# GOOGLE_CLIENT_ID=""
# GOOGLE_CLIENT_SECRET=""

# TAVUS_API_KEY: Photorealistic Real-Human AI Video Presenter (Tavus API v2)
# Free Developer Plan ($0/mo, NO credit card required, monthly recurring free minutes).
# Create a free key at https://platform.tavus.io and set it in Settings > Secrets.
TAVUS_API_KEY=""
